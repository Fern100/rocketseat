produtos = []

def main():
		print("bem vindo ao 'Check'!")
		while True:
			print("\nMenu:")
			print("1. Adicionar produto")
			print("2. Visualizar lista de produtos")
			print("3. Marcar como comprado")
			print("4. Remover compra")
			print("5. Sair")

			escolha = input("Digite o número que corresponde a opção desejada: ")

			if escolha == "1":
				adicionar_produto()
			elif escolha == "2":
				visualizar_produtos()
			elif escolha == "3":
				marcar_comprado()
			elif escolha == "4":
				excluir_produto()
			elif escolha == "5":
				print("Saindo do sistema! até breve!")
				break
			else :
				print('Opçao inválida! Por favor, tente novamente')

def adicionar_produto():

    produto = {
        "Produto": input("Digite o nome do produto desejado: "),
        "Quantidade": int(input("Digite a quantidade desejada: ")),
        "Comprado": False
    }

    if produto["Produto"] == "" or produto["Quantidade"] <= 0:
        print("Nome ou quantidade de produto inválido, tente novamente!")

    else:
        produtos.append(produto)
        print(f"Produto '{produto['Produto']}' adicionado à lista com sucesso!")

def visualizar_produtos():
  if len(produtos) < 1:
      print("Lista vazia :(, adicione novos produtos para continuar!")
  else:
    print("\nLista de produtos:")

    for produto in produtos:
        print(f"Produto: {produto['Produto']}")
        print(f"Quantidade: {produto['Quantidade']}")
        print(f"Comprado: {'Feito' if produto['Comprado'] else 'Pendente'}")
        print("\n")

def marcar_comprado():
  if len(produtos) < 1:
      print("Lista vazia :(, adicione novos produtos para continuar!")
  else:
    visualizar_produtos()
    Produto = input("Digite o nome do produto que deseja marcar como comprado: ")
    for produto in produtos:
        if produto["Produto"] == Produto:
          produto['Comprado'] = True
          print(f"Produto'{produto['Produto']}' comprado: feito")
        else:
          print("Produto não encontrado, revise a digitação do produto informado")

def excluir_produto():
  if len(produtos) < 1:
      print("Lista vazia :(, adicione novos produtos para continuar!")
  else:
    visualizar_produtos()
    Produto = input("Digite o nome do produto que deseja excluir: ")
    for produto in produtos:
        if produto["Produto"] == Produto:
          produtos.remove(produto)
          print(f"Produto'{produto['Produto']}' removido  lista com sucesso!")
        else:
          print("Produto não encontrado, revise a digitação do produto informado")

