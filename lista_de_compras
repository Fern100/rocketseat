        "produtos = []\n",
        "\n",
        "def main():\n",
        "\t\tprint(\"bem vindo ao 'Check'!\")\n",
        "\t\twhile True:\n",
        "\t\t\tprint(\"\\nMenu:\")\n",
        "\t\t\tprint(\"1. Adicionar produto\")\n",
        "\t\t\tprint(\"2. Visualizar lista de produtos\")\n",
        "\t\t\tprint(\"3. Marcar como comprado\")\n",
        "\t\t\tprint(\"4. Remover compra\")\n",
        "\t\t\tprint(\"5. Sair\")\n",
        "\n",
        "\t\t\tescolha = input(\"Digite o número que corresponde a opção desejada: \")\n",
        "\n",
        "\t\t\tif escolha == \"1\":\n",
        "\t\t\t\tadicionar_produto()\n",
        "\t\t\telif escolha == \"2\":\n",
        "\t\t\t\tvisualizar_produtos()\n",
        "\t\t\telif escolha == \"3\":\n",
        "\t\t\t\tmarcar_comprado()\n",
        "\t\t\telif escolha == \"4\":\n",
        "\t\t\t\texcluir_produto()\n",
        "\t\t\telif escolha == \"5\":\n",
        "\t\t\t\tprint(\"Saindo do sistema! até breve!\")\n",
        "\t\t\t\tbreak\n",
        "\t\t\telse :\n",
        "\t\t\t\tprint('Opçao inválida! Por favor, tente novamente')\n",
        "\n",
        "def adicionar_produto():\n",
        "\n",
        "    produto = {\n",
        "        \"Produto\": input(\"Digite o nome do produto desejado: \"),\n",
        "        \"Quantidade\": int(input(\"Digite a quantidade desejada: \")),\n",
        "        \"Comprado\": False\n",
        "    }\n",
        "\n",
        "    if produto[\"Produto\"] == \"\" or produto[\"Quantidade\"] <= 0:\n",
        "        print(\"Nome ou quantidade de produto inválido, tente novamente!\")\n",
        "\n",
        "    else:\n",
        "        produtos.append(produto)\n",
        "        print(f\"Produto '{produto['Produto']}' adicionado à lista com sucesso!\")\n",
        "\n",
        "def visualizar_produtos():\n",
        "  if len(produtos) < 1:\n",
        "      print(\"Lista vazia :(, adicione novos produtos para continuar!\")\n",
        "  else:\n",
        "    print(\"\\nLista de produtos:\")\n",
        "\n",
        "    for produto in produtos:\n",
        "        print(f\"Produto: {produto['Produto']}\")\n",
        "        print(f\"Quantidade: {produto['Quantidade']}\")\n",
        "        print(f\"Comprado: {'Feito' if produto['Comprado'] else 'Pendente'}\")\n",
        "        print(\"\\n\")\n",
        "\n",
        "def marcar_comprado():\n",
        "  if len(produtos) < 1:\n",
        "      print(\"Lista vazia :(, adicione novos produtos para continuar!\")\n",
        "  else:\n",
        "    visualizar_produtos()\n",
        "    Produto = input(\"Digite o nome do produto que deseja marcar como comprado: \")\n",
        "    for produto in produtos:\n",
        "        if produto[\"Produto\"] == Produto:\n",
        "          produto['Comprado'] = True\n",
        "          print(f\"Produto'{produto['Produto']}' comprado: feito\")\n",
        "        else:\n",
        "          print(\"Produto não encontrado, revise a digitação do produto informado\")\n",
        "\n",
        "def excluir_produto():\n",
        "  if len(produtos) < 1:\n",
        "      print(\"Lista vazia :(, adicione novos produtos para continuar!\")\n",
        "  else:\n",
        "    visualizar_produtos()\n",
        "    Produto = input(\"Digite o nome do produto que deseja excluir: \")\n",
        "    for produto in produtos:\n",
        "        if produto[\"Produto\"] == Produto:\n",
        "          produtos.remove(produto)\n",
        "          print(f\"Produto'{produto['Produto']}' removido  lista com sucesso!\")\n",
        "        else:\n",
        "          print(\"Produto não encontrado, revise a digitação do produto informado\")\n",
        "\n"
